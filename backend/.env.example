# ── Backend NestJS ─────────────────────────────────────────────────────────
PORT=3000
# En producción: NODE_ENV=production. Desactiva synchronize y aplica las migraciones
# de src/database/migrations al arrancar. DB_SYNCHRONIZE=true|false fuerza el modo.
NODE_ENV=development

# Origen(es) permitidos para CORS (separa varios con coma).
# En producción, la URL del frontend: p. ej. https://axpark.axonsia.com
CORS_ORIGIN=http://localhost:3001

# Base de datos Postgres (Neon u otro proveedor gestionado)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Autenticación (JWT). En producción es obligatorio y no puede ser "changeme":
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme

# Primer admin de plataforma en una base nueva (solo si aún no existe ninguno).
# Bórralas después del primer ingreso.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Notificaciones WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_ADMIN_PHONE=

# ── Detector de placas (detector_placas.py) ────────────────────────────────
# Corre en el PC de cada parqueadero, con su propio .env.
# En producción: https://api.tudominio.com/parking/entry
PARKING_API_URL=http://localhost:3000/parking/entry
# Clave de ESTE detector. Se crea en el panel: Admin → negocio → Detectores de placas.
# Cada clave pertenece a un solo parqueadero; el backend deduce el negocio de ella.
DETECTOR_API_KEY=
DETECTOR_DEFAULT_VIDEO=carro1.mp4
# Archivo de la cola offline (placas pendientes de enviar si se cae internet).
DETECTOR_QUEUE_FILE=cola_detector.jsonl

# Cámara Tapo (RTSP). Crea la cuenta en la app Tapo:
# Cámara → Ajustes → Configuración avanzada → Cuenta de la cámara
TAPO_USER=
TAPO_PASS=
